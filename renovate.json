{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "packageRules": [
    {
      "automerge": true,
      "automergeStrategy": "squash",
      "matchPackageNames": [
        "*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "automerge": true,
      "automergeStrategy": "squash",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "*"
      ],
      "matchUpdateTypes": [
        "digest",
        "major",
        "minor",
        "patch"
      ]
    },
    {
      "description": "Require manual merge for falco chart major/minor bumps, each in its own PR; patch keeps automerging.",
      "automerge": false,
      "separateMajorMinor": true,
      "matchManagers": [
        "helmv3"
      ],
      "matchPackageNames": [
        "falco"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ]
    }
  ]
}
